# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Groq retires models from time to time - change these if a model is no longer listed
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Optional: your fine-tuned simplifier (finetune/serve_simplifier.py), e.g. http://localhost:8001/simplify
SIMPLIFIER_URL=
SESSION_TTL_MINUTES=30
CORS_ORIGINS=http://localhost:5173
# Registration deed estimate (percent). Verify current state rates.
STAMP_DUTY_PERCENT=7
REGISTRATION_FEE_PERCENT=2
# Set to 1 to force the offline mock LLM
FORMSAATHI_MOCK_LLM=0
